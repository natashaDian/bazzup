generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  supabaseUserId   String   @unique
  email            String   @unique
  name             String
  phone            String?
  role             Role
  businessName     String?
  businessType     String?
  targetMarket     String?
  businessDesc     String?
  isVerifiedVendor Boolean  @default(false)
  profileImageUrl  String?
  coverImageUrl    String?
  instagram        String?
  whatsapp         String?
  tiktok           String?
  website          String?
  createdAt        DateTime @default(now())

  bazaars         Bazaar[]
  applications    Application[]
  notifications   Notification[]
  reviewsAuthored Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewReceiver")
  products        Product[]
  portfolios      Portfolio[]
}

model Bazaar {
  id             String       @id @default(cuid())
  organizerId    String
  organizer      User         @relation(fields: [organizerId], references: [id])
  title          String
  description    String?
  address        String
  city           String
  latitude       Float?
  longitude      Float?
  eventStartDate DateTime
  eventEndDate   DateTime
  status         BazaarStatus @default(DRAFT)
  createdAt      DateTime     @default(now())

  areas  Area[]
  images BazaarImage[]

  @@index([city, status])
  @@index([organizerId])
}

model BazaarImage {
  id       String @id @default(cuid())
  bazaarId String
  bazaar   Bazaar @relation(fields: [bazaarId], references: [id], onDelete: Cascade)
  url      String

  @@index([bazaarId])
}

model Area {
  id               String   @id @default(cuid())
  bazaarId         String
  bazaar           Bazaar   @relation(fields: [bazaarId], references: [id])
  name             String
  description      String?
  totalSlot        Int
  pricePerSlot     Int
  categoryWanted   String?
  estimatedTraffic Int?
  visitorProfile   String?
  peakHours        String?
  hasElectricity   Boolean  @default(false)
  createdAt        DateTime @default(now())

  images       AreaImage[]
  applications Application[]

  @@index([bazaarId])
}

model AreaImage {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  url    String

  @@index([areaId])
}

model Application {
  id                 String            @id @default(cuid())
  areaId             String
  area               Area              @relation(fields: [areaId], references: [id])
  vendorId           String
  vendor             User              @relation(fields: [vendorId], references: [id])
  businessCategory   String
  description        String?
  matchScore         Int?
  slotNumber         Int?
  status             ApplicationStatus @default(PENDING)
  rejectReason       String?
  rejectedAt         DateTime?
  cancelReason       String?
  cancelledAt        DateTime?
  appliedAt          DateTime          @default(now())
  approvedAt         DateTime?
  totalPrice         Int?
  platformFee        Int?
  paymentDeadline    DateTime?
  paidAt             DateTime?
  transactionId      String?
  paymentConfirmedAt DateTime?
  invoiceSentAt      DateTime?

  reviews Review[]

  @@unique([areaId, slotNumber])
  @@index([areaId, status])
  @@index([vendorId])
}

model Review {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  authorId      String
  author        User        @relation("ReviewAuthor", fields: [authorId], references: [id])
  revieweeId    String
  reviewee      User        @relation("ReviewReceiver", fields: [revieweeId], references: [id])
  type          ReviewType
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([authorId])
  @@index([revieweeId])
}

model Product {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([vendorId])
}

model Portfolio {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bazaarName String
  eventDate  DateTime
  photoUrl   String
  createdAt  DateTime @default(now())

  @@index([vendorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  ORGANIZER
  VENDOR
}

enum BazaarStatus {
  DRAFT
  ACTIVE
  FULL
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum ReviewType {
  VENDOR_TO_BAZAAR
  ORGANIZER_TO_VENDOR
}